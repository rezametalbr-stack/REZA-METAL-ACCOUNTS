rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rezametalbr@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.firebase.sign_in_provider == 'anonymous'
      );
    }

    function isStaff() {
      return isSignedIn();
    }

    // Robust generic validation for now to avoid key mismatch errors
    function isValidData(data, requiredKeys) {
      return data.keys().hasAll(requiredKeys);
    }

    // Collections
    match /products/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /customers/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /suppliers/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /salespeople/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /sales/{id} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /purchases/{id} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /commissions/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /expenses/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /accounts/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /journalEntries/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /stockAdjustments/{id} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /reminders/{id} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /settings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{id} {
      allow read: if isSignedIn();
      allow write: if (isSignedIn() && request.auth.uid == id) || isAdmin();
    }

    // Catch-all for any other collection (development only)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
